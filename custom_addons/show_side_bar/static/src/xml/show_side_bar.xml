<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="show_side_bar.NavBarAppsMenuPatch" t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
    <xpath expr="//t[@t-if='env.isSmall']" position="replace">
      <a href="/odoo" class="o_menu_toggle border-0 d-none" t-att-class="{'hasImage': currentApp?.webIconData}" accesskey="h" t-ref="menuApps" t-on-click.prevent="_openAppMenuSidebar">
        <t t-call="web.NavBar.AppsMenu.Sidebar"/>
      </a>
    </xpath>
  </t>
</templates>
