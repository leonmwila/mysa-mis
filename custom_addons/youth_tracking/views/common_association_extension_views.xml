<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_common_association_form_youth_extension" model="ir.ui.view">
        <field name="name">common.association.form.youth.extension</field>
        <field name="model">common.association</field>
        <field name="inherit_id" ref="associations_organizations.view_common_association_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='organization_type']" position="after">
                <field name="youth_zone_id" invisible="not is_youth"/>
            </xpath>

            <xpath expr="//field[@name='description']/.." position="after">
                <group string="Youth Members" invisible="not is_youth">
                    <field name="youth_member_ids" context="{'default_common_association_ids': [(4, id)]}">
                        <list>
                            <field name="name"/>
                            <field name="youth_id"/>
                            <field name="gender"/>
                            <field name="status"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
